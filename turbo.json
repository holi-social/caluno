{
  "$schema": "https://v2-9-9.turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DB_HOST",
    "DB_PORT",
    "DB_USER",
    "DB_PASSWORD",
    "DB_NAME",
    "POSTGRES_PORT",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "codegen"]
    },
    "codegen": {
      "dependsOn": ["^codegen"],
      "inputs": ["../../apps/backend/src/schema.gql", "src/**/*.graphql"],
      "outputs": ["src/generated/**"]
    },
    "codegen:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["db:up", "codegen"]
    },
    "db:up": {
      "cache": false
    },
    "db:down": {
      "cache": false
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    }
  }
}
