{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":label('renovatebot')",
    ":enableVulnerabilityAlertsWithLabel('renovatebot/security')",
    ":semanticCommits",
    ":automergePatch",
    ":automergeTesters",
    ":automergeLinters"
  ],
  "configMigration": true,
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchSourceUrls": ["https://github.com/hashicorp/terraform"],
      "groupName": "terraform"
    }
  ],
  "enabled": false
}
