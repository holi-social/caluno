@startuml
'package "Identity & Multi-Tenancy" {
    class Organisation {
        id: UUID
        name: String
    }
    
    ' Allows Org A to have children B1 and B2
    class OrgUnit {
        id: UUID
        name: String
        parentId: UUID
    }
    note right: Permissions cascade downward.\nDefinitions can be Global (root)\nor Local (suborg).

    ' Department", "Shelter", "Mobile Unit"
    class OrgUnitType {
        name: String
    }

    ' The physical building where shifts actually happen
    class Location {
        name: String
    }

    class User {
        id: UUID
        name: String
        email: String
    }
    note left: GDPR:\nDo not hard-delete? \nAnonymize data on account deletion\nto preserve legal audit trails\nwe should understand\nwhat are the requirement here.

    ' Protects data. Users have global accounts, but their profile should be scoped to the Organisation.
    ' If you work for Stadtmission, your IBAN will be safely locked to the Stadtmission Organisation.
    class OrganisationUserProfile {
        address: String
        bankAccountNumber: String
    }
'}

'package "Access & Roles" {
    
    ' like, "Supervisor", "Volunteer"
    class Role {
        name: String
    }

    ' like 'shift:create', 'session:approve'.
    class Permission {
        key: String
    }

    ' Grants a User access to a specific OrgUnit. Because of the OrgUnit tree,
    ' placing a Membership at Org A automatically grants access to B1 and B2.
    class Membership {
        status {active, suspended}
    }

    ' The Waiting Room. Keeps the 'Membership' table perfectly clean.
    ' Documents are NOT attached here so they survive after the request is approved.
    class MembershipRequest {
        status {pending, accepted, rejected}
    }
    note right: The "Waiting Room".\nDoes NOT own compliance documents.\nMust not block yearly renewals
'}

package "Compliance & Qualifications" {
    
    ' The rule itself > "ID Check" 
    ' Owned by OrgUnit. If Root creates it, it cascades to all children
    ' If a Sub-Org creates it, only that Sub-Org sees it
    class Requirement {
        name: String 
        type {document, check}
    }

    ' grouping mechanism
    class RequirementProfile {
        name: String 
    }

    ' groups the user's fulfillments together
    class RequirementProfileSubmission {
        status {pending, approved, rejected}
        submittedAt: DateTime
    }

    ' Linked directly to the User. If B1 and B2 both 
    ' ask for the "ID Check", Max's single fulfillment satisfies both automatically.
    class RequirementFulfillment {
        status {pending, verified, expired}
        valueJSON: JSON
    }
    note bottom: Anchored to the User, NOT the Application.\nFulfills the criteria globally.

    ' The physical file, it's owned by the User so they can reuse their scans
    class Document {
        storageKey: String
    }
}

package "Operations" {
    
    ' A planned block of time requiring volunteers.
    class Shift {
        start: DateTime
    }

    ' Links a User to a planned Shift
    class ShiftAssignment {
        status {invited, accepted}
    }

    class TimeEntry {
        start: DateTime
        end: DateTime
        status {pending, validated, rejected}
    }

    ' Immutable audit. If an Admin rejects a TimeEntry, it logs exactly 
    ' who did it and why, without destroying the original clock-in time.
    class ValidationAction {
        note: String
    }
}

' --- Identity & Organisation ---
Organisation "1" -- "1\nroot" OrgUnit : "contains >"
Organisation "1" -down- "*" OrganisationUserProfile : "secures >"
User "1" -up- "*" OrganisationUserProfile : "has >"
OrgUnit "*" -up- "1" OrgUnitType : "categorized by >"
OrgUnit "*\nchild" o-- "1\nparent" OrgUnit : "cascades down <"
Location "0..1" -up- "*" OrgUnit : "hosts >"

' --- Access & Roles ---
Membership "*" -down- "1" User : "granted to >"
Membership "*" -up- "1" OrgUnit : "applies to >"
Membership "*" -- "*" Role : "contains >"
Role "*" -- "*" Permission : "groups >"

' --- Requests ---
OrgUnit "1" -down- "*" MembershipRequest : "receives >"
MembershipRequest "*" -right- "1" User : "submitted by >"

' --- Compliance ---
OrgUnit "1" -- "*" Requirement : "defines >"
OrgUnit "1" -- "*" RequirementProfile : "defines >"

RequirementProfile "*" -- "*" Requirement 

User "1" -down- "*" RequirementProfileSubmission : "submits >"
OrgUnit "1" -down- "*" RequirementProfileSubmission : "receives >"
RequirementProfile "1" -down- "*" RequirementProfileSubmission : "based on >"

RequirementProfileSubmission "*" -- "*" RequirementFulfillment : "contains >"
User "1" -- "*" RequirementFulfillment : "achieves >"
Requirement "1" -- "*" RequirementFulfillment : "satisfies <"
RequirementFulfillment "*" -- "0..1" Document : "backed by >"
User "1" -down- "*" Document : "owns >"

' --- Operations ---
Location "0..1" -- "*" Shift : "hosts >"
OrgUnit "0..1" -- "*" Shift : "manages >"
ShiftAssignment "*" -up- "1" User : "assigned to >"
Shift "1" -- "*" ShiftAssignment : "includes >"
TimeEntry "*" -up- "1" User : "clocked by >"
TimeEntry "*" -- "0..1" Shift : "logged against >"
TimeEntry "1" -- "0..1" ValidationAction : "audited via >"
@enduml