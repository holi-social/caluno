@startuml clippy

skinparam classAttributeIconSize 0
skinparam linetype ortho

' package "Identity & Organisation" {
    class Organisation {
        name
        slug
        email
        phone
        websiteUrl
        description
        logoUrl
    }

    class OrgUnit {
        name
        slug
        isRoot
        logoUrl
        websiteUrl
        email
        phone
        description
        address
        deletedAt
    }
    note left: Root OrgUnit has parentId = NULL.\nOnly one root per Organisation.\nPermissions cascade downward.

    class OrgUnitType {
        name
        description
        icon
    }

    class User {
        name
        email
        image
        checkInId
    }
    note top: GDPR: anonymize on deletion,\npreserve audit trails.

    class OrganisationUserProfile {
        note
        status {ACTIVE, INACTIVE, BLACKLISTED, PENDING}
        userProfileAccessApproved
    }

    class Document {
        name
        mimeType
        storageKey
        uploadedAt
    }
' }

' package "Access & Roles" {
    class Membership {
    }
    note bottom: Links User to OrgUnit via Role.\nA user can have multiple memberships\nacross the OrgUnit tree.

    class Role {
        name
        description
        isInternal
    }

    class Permission {
        key
        description
    }

    class MembershipRequest {
        status {PENDING, ACCEPTED, REJECTED, CANCELLED}
        reviewedAt
        rejectionReason
        metadata: { intendedShiftIds?: string[] }
    }
    note top: The "Waiting Room".\nUnique constraint on (userId, orgUnitId).\nA rejected/cancelled request blocks\nre-application unless constraint is removed.
' }

package "Compliance & Qualifications" {
    class RequirementProfile {
        name
        description
    }

    class Requirement {
        type {CHECK, DATE, DOCUMENT, TEXT}
        name
        description
        mandatory
    }

    class RequirementProfileSubmission {
        status {DRAFT, SUBMITTED, APPROVED, REJECTED}
        submittedAt
        reviewedAt
    }

    class RequirementFulfillment {
        type {CHECK, DATE, DOCUMENT, TEXT}
        value: JSON
        status {DRAFT, SUBMITTED, APPROVED, REJECTED}
        submittedAt
        reviewedAt
    }
    note left: Anchored to OrganisationUserProfile\nfor reuse across OrgUnits.
    class RequirementFulfillmentUpload extends RequirementFulfillment {}
    class RequirementFulfillmentCheck extends RequirementFulfillment {}
    class RequirementFulfillmentDate extends RequirementFulfillment {}
    class RequirementFulfillmentText extends RequirementFulfillment {}
}

package "Operations" {
    class Shift {
        title
        slug
        instructions
        location
        visibility {ALL_MEMBERS, INVITED_MEMBERS}
        maxVolunteers
        rrule
        originalStartsAt
        durationMinutes
        isDeleted
    }
    note left: A Shift is a recurring pattern (master).\nrrule defines recurrence.\nVolunteers join ShiftInstances, not Shifts.

    class ShiftInstance {
        actualStartsAt
        actualEndsAt
        overrideTitle
        overrideInstructions
        overrideLocation
        overrideMaxVolunteers
        isException
        isCancelled
        occurrenceIndex
    }
    note left: A concrete occurrence of a Shift.\nCan override master fields.\nisException = one-off change.\nisCancelled = skipped occurrence.

    class ShiftInstanceInvite {
        status {PENDING, ACCEPTED, REJECTED}
    }

    class TimeEntry {
        startedAt
        endedAt
        notes
    }
}

' --- Identity & Organisation ---
Organisation [root] "1" -- "1" OrgUnit
Organisation "1" -- "*" OrganisationUserProfile
User "1" -up- "*" OrganisationUserProfile
OrgUnit "*" -up- "1" OrgUnitType
OrgUnit "*\nchild" o-- "1\nparent" OrgUnit

' --- Access & Roles ---
OrgUnit "1" -- "*" Membership
Membership "*" -left- "1" User
Role "*" -up- "*" Permission
Role "*" -- "*" Membership
OrgUnit "1" -right- "*" [root] Role : "defines >"

' --- Membership Requests ---
OrgUnit "1" -- "*" MembershipRequest : "receives >"
MembershipRequest "*" -- "1" User : "submitted by >"

' --- Requirement Profiles ---
OrgUnit "1" -- "*" RequirementProfile : "??? requires >"
OrgUnit "1" -- "*" [root] RequirementProfile : "defines >"
OrgUnit "1" -- "*" [root] Requirement : "defines >"
RequirementProfile "*" -left- "*" Requirement : "groups >"

' --- Submissions & Fulfillments ---
Membership "0..1" -- "*" RequirementProfileSubmission
MembershipRequest "0..1" -- "*" RequirementProfileSubmission
RequirementProfileSubmission "*" -- "1" RequirementProfile : "fulfills >"
RequirementProfileSubmission "*" -left- "*" RequirementFulfillment : "contains >"
RequirementFulfillment "*" -- "1" Requirement : "satisfies >"
RequirementFulfillment "*" -- "0..1" OrganisationUserProfile : "stored for reuse <"
RequirementFulfillment "*" -- "0..1" Document : "backed by >"
User "1" -- "*" Document : "owns >"

' --- Shifts ---
OrgUnit "1" -- "*" Shift : "manages >"
Shift "1" -- "*" ShiftInstance : "occurs as >"
ShiftInstance "1" -- "*" ShiftInstanceInvite : "includes >"
ShiftInstanceInvite "*" -- "1" User : "assigned to >"

' --- Time Tracking ---
ShiftInstance "1" -- "*" TimeEntry : "logged against >"
User "1" -- "*" TimeEntry : "clocked by >"

@enduml
