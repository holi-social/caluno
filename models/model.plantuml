@startuml clippy
class Organisation {
    name
    invoiceAddress
    ...
}
note top: There is only one Organisation\nconnected to the root OrgUnit
class OrgUnit {
    name
    description
    ...
}
class OrgUnitType {
    name
    description
    icon
}
class Location {
    name
    street
    zip
    city
    country
    ...
}
class User {
    name
    email
    phoneNumber
    address
    bankAccountNumber
    ...
}
class OrganisationUserProfile {
    grantAccessPhoneNumber
    grantAccessAddress
    grantAccessBankAccountNumber
    note
    status {pending, active, blacklisted, inactive}
}
class IncidentReport {
    description
}
class Shift {
    start
    end
}
class TimeEntry {
    start
    end
    status {started, finished, validated, rejected}
    note ?
}
note bottom: How do we manage\nstatus and validation?
class Membership {
}
class Role {
    name
    description
}
class Permission {
    key
    description
}
class MembershipRequest {
    status {pending, accepted, rejected}
    reviewedBy
    reviewedAt
    rejectionReason
}
class ShiftAssignment {
    status {invited, accepted, rejected}
}
note right: How is reject => update\nof a TimeEntry working?
package RequirementProfiles {
    class RequirementProfile {
        name
        description
    }
    class Requirement {
        type {document, check, date, ...}
        name
        description
        mandatory
    }
    class RequirementProfileSubmission {
        status {draft, submitted, approved, rejected}
        submittedAt
        reviewedAt
        reviewedBy
    }
    class RequirementFulfillment {
        value: text/JSON
        status {draft, submitted, approved, rejected}
        submittedAt
        reviewedAt
        reviewedBy
    }
}
class Document {
    name
    mimeType
    storageKey
    uploadedAt
}



Organisation [root] -down- "1" OrgUnit
OrgUnit "*" -left- "1" OrgUnitType : "categorized by >"
OrgUnit "*\nchild" o-- "1\nparent" OrgUnit
OrgUnit "0..1" -- "*" Shift

OrgUnit "1" -right- "*" Membership
Membership "*" -down- "1" User

Organisation "1" -- "*"OrganisationUserProfile : "owns >"
OrganisationUserProfile "*" -- "1" User

OrgUnit "1" -down- "*" MembershipRequest : "receives >"
MembershipRequest "*" -right- "1" User : "submitted by >"

OrgUnit "*" -- "0..1" Location : "is at >"
Location "0..1" -- "*" Shift : "is at <"

Role "*" -up- "*" Permission : "groups >"
Role "*" -- "*" Membership
Organisation "1" -right- "*" Role : "defines >"

OrgUnit -up- "*" RequirementProfile : selects >
Organisation "1" -right- "*" RequirementProfile : "defines >"
RequirementProfile -right- "*" Requirement : "groups >"
User "1" -right- "*" Document : "owns >"
RequirementFulfillment "*" -down- "0..1" Document : "backed by >"
Membership "0..1" -right- "*" RequirementProfileSubmission
RequirementProfileSubmission -right- "*" RequirementFulfillment
' 
MembershipRequest "0..1" -left- "*" RequirementProfileSubmission
RequirementProfileSubmission "*" -up- "1" RequirementProfile : "fulfills >"
RequirementFulfillment "*" -up- "1" Requirement : "fulfills >"
RequirementFulfillment "*" .. "1" OrganisationUserProfile : "store for reuse <"
RequirementProfileSubmission "*" .. "1" OrganisationUserProfile : "store for reuse <"
note "At least one is needed" as Note1
(RequirementProfileSubmission, OrganisationUserProfile) .. Note1
(RequirementFulfillment, OrganisationUserProfile) .. Note1

OrganisationUserProfile "1" -- "*" IncidentReport
IncidentReport "*" -- "1" User : "reported by >"

User "1" -- "*" ShiftAssignment
Shift "1" -- "*" ShiftAssignment
User "1" -- "*" TimeEntry
TimeEntry "*" -- "1" Shift : "logged against >"

@enduml