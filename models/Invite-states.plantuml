@startuml InviteOriginStatusModel

title Invite origin (how they arrived) vs status (latest answer)

'state "origin" as Origin {
'  [*] --> ORIGIN_ADMIN_INVITED : admin invite
'  [*] --> ORIGIN_VOLUNTEER_JOINED : open join
'}

state "Join" as Join {
[*] --> ADMIN_INVITED : admin invited
[*] --> AWAITING_ADMIN_APPROVAL : volunteer joined \n approval enabled
[*] ---> JOINED : volunteer joined \n approval disabled
AWAITING_ADMIN_APPROVAL --> JOINED : admin approved
AWAITING_ADMIN_APPROVAL --> ADMIN_REJECTED : admin rejected
AWAITING_ADMIN_APPROVAL --> VOLUNTEER_CANCELLED : volunteer cancels
ADMIN_INVITED --> JOINED : volunteer accepted \n approval disabled
ADMIN_INVITED --> AWAITING_ADMIN_APPROVAL : volunteer accepted \n approval
ADMIN_INVITED --> VOLUNTEER_REJECTED : volunteer rejected
VOLUNTEER_REJECTED --> AWAITING_ADMIN_APPROVAL : volunteer re-joins \n approval
VOLUNTEER_REJECTED --> JOINED : volunteer re-joins \n no approval
ADMIN_INVITED --> ADMIN_REJECTED : admin rejected
JOINED --> VOLUNTEER_CANCELLED : volunteer cancels
JOINED --> ADMIN_CANCELLED : admin cancels

[*] --> WAITLIST_AWAITING_ADMIN_APPROVAL : volunteer joined \n approval enabled \n shift full
WAITLIST_AWAITING_ADMIN_APPROVAL --> WAITLIST_JOINED : admin approved
WAITLIST_AWAITING_ADMIN_APPROVAL --> AWAITING_ADMIN_APPROVAL : seat becomes available
WAITLIST_JOINED --> JOINED : seat becomes available

[*] --> WAITLIST_JOINED : volunteer joined \n approval disabled \n shift full

ADMIN_INVITED --> WAITLIST_AWAITING_ADMIN_APPROVAL : volunteer accepted \n approval enabled \n shift full
ADMIN_INVITED --> WAITLIST_JOINED : volunteer accepted \n approval disabled \n shift full

WAITLIST_JOINED --> VOLUNTEER_CANCELLED : volunteer cancels
WAITLIST_AWAITING_ADMIN_APPROVAL --> VOLUNTEER_CANCELLED : volunteer cancels

VOLUNTEER_CANCELLED -up-> JOINED : volunteer re-joins \n approval disabled
VOLUNTEER_CANCELLED -up-> AWAITING_ADMIN_APPROVAL : volunteer re-joins \n approval enabled
VOLUNTEER_CANCELLED -up-> WAITLIST_JOINED : volunteer re-joins \n approval disabled \n shift full
VOLUNTEER_CANCELLED -up-> WAITLIST_AWAITING_ADMIN_APPROVAL : volunteer re-joins \n approval enabled \n shift full

ADMIN_REJECTED -up-> ADMIN_INVITED : admin re-invites
ADMIN_CANCELLED -up-> ADMIN_INVITED : admin re-invites
}

@enduml
