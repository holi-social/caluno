@startuml InviteOriginStatusModel

title Invite origin (how they arrived) vs status (latest answer)

'state "origin" as Origin {
'  [*] --> ORIGIN_ADMIN_INVITED : admin invite
'  [*] --> ORIGIN_VOLUNTEER_JOINED : open join
'}

state "Join" as Join {
[*] --> ADMIN_INVITED : admin invited
[*] --> AWAITING_ADMIN_APPROVAL : volunteer joined \n approval enabled
[*] --> WAITLIST_JOINED : volunteer joined \n approval disabled \n shift full
[*] --> JOINED : volunteer joined \n approval disabled \n seat available

ADMIN_INVITED --> VOLUNTEER_REJECTED : volunteer rejected
ADMIN_INVITED --> AWAITING_ADMIN_APPROVAL : volunteer accepted \n approval enabled
ADMIN_INVITED --> WAITLIST_JOINED : volunteer accepted \n approval disabled \n shift full
ADMIN_INVITED --> JOINED : volunteer accepted \n approval disabled \n seat available
ADMIN_INVITED --> ADMIN_REJECTED : admin rejected

VOLUNTEER_REJECTED --> AWAITING_ADMIN_APPROVAL : volunteer re-joins \n approval enabled
VOLUNTEER_REJECTED --> WAITLIST_JOINED : volunteer re-joins \n approval disabled \n shift full
VOLUNTEER_REJECTED --> JOINED : volunteer re-joins \n approval disabled \n seat available

AWAITING_ADMIN_APPROVAL --> ADMIN_REJECTED : admin rejected
AWAITING_ADMIN_APPROVAL --> VOLUNTEER_CANCELLED : volunteer cancels
AWAITING_ADMIN_APPROVAL -right-> WAITLIST_JOINED : admin approved \n shift full
AWAITING_ADMIN_APPROVAL --> JOINED : admin approved \n seat available

WAITLIST_JOINED --> JOINED : seat becomes available
WAITLIST_JOINED --> VOLUNTEER_CANCELLED : volunteer cancels
WAITLIST_JOINED --> ADMIN_REJECTED : admin rejects

JOINED --> VOLUNTEER_CANCELLED : volunteer cancels
JOINED --> ADMIN_REJECTED : admin rejects

VOLUNTEER_CANCELLED -up-> JOINED : volunteer re-joins \n seat available
VOLUNTEER_CANCELLED -up-> WAITLIST_JOINED : volunteer re-joins \n shift full

ADMIN_REJECTED -up-> ADMIN_INVITED : admin re-invites
}

@enduml
