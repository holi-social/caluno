@startuml InviteStatusModel

[*] --> INVITED
' means the member self-joined without an invite
[*] --> SELF_JOINED
INVITED --> ACCEPTED
INVITED --> VOLUNTEER_REJECTED
VOLUNTEER_REJECTED -left-> ACCEPTED
SELF_JOINED -down-> CANCELLED
ACCEPTED -down-> CANCELLED
CANCELLED -up-> SELF_JOINED
CANCELLED -up-> ACCEPTED

'INVITED -down-> ADMIN_REJECTED
'ADMIN_REJECTED -up-> INVITED
'SELF_JOINED --> ADMIN_REJECTED
@enduml