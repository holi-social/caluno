{
	"name": "clippy",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "bun run db:up && turbo run dev",
		"lint": "turbo run format-and-lint",
		"format": "turbo run format-and-lint:fix",
		"check-types": "turbo run check-types",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write",
		"db:up": "docker compose up -d && bun run db:wait",
		"db:down": "docker compose down",
		"db:wait": "docker compose exec postgres sh -c 'until pg_isready -U ${POSTGRES_USER:-postgres}; do sleep 1; done'"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"turbo": "^2.7.5",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.5",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
