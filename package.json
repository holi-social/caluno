{
  "name": "clippy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run db:up && turbo run dev",
    "lint": "turbo run format-and-lint",
    "format": "turbo run format-and-lint:fix",
    "check-types": "turbo run check-types",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "db:up": "docker compose up -d postgres && bun run db:wait",
    "db:down": "docker compose down",
    "db:wait": "docker compose exec postgres sh -c 'until pg_isready -U ${POSTGRES_USER:-postgres}; do sleep 1; done'",
    "db:migrate": "bun run --cwd apps/backend db:migrate",
    "codegen": "turbo run codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "turbo": "^2.8.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
