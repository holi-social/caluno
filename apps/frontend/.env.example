BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Optional: allow next/image to load uploaded public files (defaults cover localhost MinIO)
NEXT_PUBLIC_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/caluno

# ─── Sentry (error reporting) ───
# Public DSN of the frontend Sentry project — safe to expose in the client bundle.
# Leave unset in local dev: the SDK stays fully disabled without it.
# NEXT_PUBLIC_SENTRY_DSN=
# Environment tag: development | staging | production (defaults from NODE_ENV).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Optional trace-sample override (0..1); per-env defaults apply when unset.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Session Replay opt-in (masks all text, blocks all media when enabled).
# NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
# Server-side only (never committed with real values):
# SENTRY_DSN=              # server runtime DSN (falls back to NEXT_PUBLIC_SENTRY_DSN)
# SENTRY_RELEASE=          # git SHA, set by CI
