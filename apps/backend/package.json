{
  "name": "clippy-backend",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && cp -r src/database/migrations dist/src/database/ && cp -r src/i18n/locales dist/src/i18n/",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "check-types": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "format-and-lint": "biome check",
    "format-and-lint:fix": "biome check --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration:setup": "bun run test/setup-test-db.ts",
    "test:integration": "bun test test/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node dist/src/database/seed.js",
    "db:seed:dev": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "db:fixtures": "bun run src/database/fixtures.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "@better-auth/drizzle-adapter": "^1.5.3",
    "@nestjs/apollo": "^13.2.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/graphql": "^13.2.3",
    "@nestjs/platform-express": "^11.0.1",
    "@thallesp/nestjs-better-auth": "^2.2.2",
    "better-auth": "^1.6.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dataloader": "^2.2.3",
    "drizzle-kit": "^1.0.0-beta.15",
    "drizzle-orm": "^1.0.0-beta.15",
    "express": "^5.2.1",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "mjml": "^5.3.0",
    "nanoid": "^6.0.0",
    "nestjs-i18n": "^10.8.4",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.1",
    "short-unique-id": "^5.3.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/mjml": "^5.0.0",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "rootDir": "src"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(nanoid)/)"
    ]
  }
}
