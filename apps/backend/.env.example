# Backend Server
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clippy

# Authentication
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:8080

# Frontend URL (must be in trustedOrigins)
WEB_URL=http://localhost:3000

# Cookie domain for cross-subdomain auth (optional).
# Set when frontend and API use different subdomains (e.g. staging.clippy.holi.social + api.clippy.holi.social).
# Use the shared parent domain without leading dot, e.g. COOKIE_DOMAIN=clippy.holi.social
# COOKIE_DOMAIN=

# Email — Scaleway Transactional Email (optional in local dev; emails are logged
# to console when SCW_SECRET_KEY is not configured)
# SCW_SECRET_KEY=
# SCW_PROJECT_ID=
# SCW_TEM_FROM_EMAIL=noreply@your.domain
# SCW_TEM_FROM_NAME=Clippy
# SCW_TEM_REGION=fr-par