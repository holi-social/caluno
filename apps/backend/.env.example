# Backend Server
PORT=5001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clippy

# Authentication
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:5001

# Frontend URL (must be in trustedOrigins)
WEB_URL=http://localhost:3000

# Cookie domain for cross-subdomain auth (optional).
# Set when frontend and API use different subdomains (e.g. staging.clippy.holi.social + api.clippy.holi.social).
# Use the shared parent domain without leading dot, e.g. COOKIE_DOMAIN=clippy.holi.social
# COOKIE_DOMAIN=