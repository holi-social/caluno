# Backend Server
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=caluno

# Authentication
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:8080

# Frontend URL (must be in trustedOrigins)
WEB_URL=http://localhost:3000

# Cookie domain for cross-subdomain auth (optional).
# Set when frontend and API use different subdomains (e.g. staging.app.caluno.org + staging.api.caluno.org).
# Use the shared parent domain without leading dot, e.g. COOKIE_DOMAIN=caluno.org
# COOKIE_DOMAIN=

# Email — Scaleway Transactional Email (optional in local dev; emails are logged
# to console when TEM_SECRET_KEY is not configured)
# PROJECT_ID=
# TEM_SECRET_KEY=
# TEM_REGION=fr-par

# Object storage (MinIO locally via docker-compose; Scaleway in production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=caluno
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/caluno